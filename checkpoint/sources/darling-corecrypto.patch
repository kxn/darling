+int cccurve25519_make_priv(struct ccrng_state *rng, ccec25519secretkey sk) {
+    if (!rng || !rng->generate || !sk) return CCERR_PARAMETER;
+    int status = ccrng_generate(rng, 32, sk);
+    if (status) { cc_clear(32, sk); return status; }

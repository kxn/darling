+++ b/src/simple/log_simple_darling.h
@@ -0,0 +1,17 @@
+/* Darling backend declarations for the Apple simple-log source port. */
+#include <stdbool.h>
+#include <pthread.h>
+#include <i386/cpu_capabilities.h>

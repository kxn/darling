--- /dev/null
+++ b/src/simple/log_simple_transport.c
@@ -0,0 +1,86 @@
+/* The upstream simple-log encoder uses a connected Unix datagram socket.
+ * Keep that wire transport on Darling. This module does not emulate logd or
+ * report a successful send when the receiver is absent.
+ */
+#include <os/log_simple_private.h>
+#include "log_simple_darling.h"
+#include <os/lock.h>
+#include <_simple.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/syslog.h>
+#include <sys/un.h>
+#include <unistd.h>
+static os_unfair_lock transport_lock = OS_UNFAIR_LOCK_INIT;
+static int transport_fd = -1;
+static int connection_attempted;
+static pid_t transport_pid;
+
+static void repair_child_lock(void) {
+    pid_t pid = getpid(), expected = 0;
+    if (!__atomic_compare_exchange_n(&transport_pid, &expected, pid, 0,
+            __ATOMIC_RELAXED, __ATOMIC_RELAXED) && expected != pid) {
+        /* fork leaves a single thread in the child. A parent's locked unfair
+         * lock cannot be acquired there. The inherited socket remains valid. */
+        transport_lock = (os_unfair_lock)OS_UNFAIR_LOCK_INIT;
+        if (transport_fd < 0) connection_attempted = 0;
+        __atomic_store_n(&transport_pid, pid, __ATOMIC_RELAXED);
+    }
+}
+
+static int connect_receiver(void) {
+    const char *disabled = getenv("ASL_DISABLE");
+    if (disabled && !strcmp(disabled, "1")) return -1;
+    const char *path = getenv("DARLING_SIMPLE_LOG_SOCKET");
+    if (!path) path = _PATH_LOG;
+    struct sockaddr_un address = {0};
+    if (strlen(path) >= sizeof(address.sun_path)) { errno = ENAMETOOLONG; return -1; }
+    address.sun_family = AF_UNIX;
+    address.sun_len = sizeof(address);
+    strlcpy(address.sun_path, path, sizeof(address.sun_path));
+    int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    if (fd < 0) return -1;
+    if (fcntl(fd, F_SETFD, FD_CLOEXEC) == -1 ||
+        connect(fd, (const struct sockaddr *)&address, sizeof(address)) == -1) {
+        int error = errno; close(fd); errno = error; return -1;
+    }
+    return fd;
+}
+
+__attribute__((visibility("hidden")))
+int _simple_asl_get_fd(void) {
+    repair_child_lock();
+    os_unfair_lock_lock(&transport_lock);
+    if (!connection_attempted) {
+        connection_attempted = 1;
+        transport_fd = connect_receiver();
+    }
+    int fd = transport_fd;
+    os_unfair_lock_unlock(&transport_lock);
+    return fd;
+}
+
+void _os_log_simple_reinit_4launchd(void) {
+    repair_child_lock();
+    os_unfair_lock_lock(&transport_lock);
+    if (transport_fd >= 0) {
+        _simple_dprintf(STDERR_FILENO, "os_log_simple: launchd reconnect after successful initialization\n");
+        __builtin_trap();
+    }
+    connection_attempted = 1;
+    transport_fd = connect_receiver();
+    os_unfair_lock_unlock(&transport_lock);
+}
+
+__attribute__((visibility("hidden")))
+void _darling_os_log_simple_diagnostic(const os_log_simple_payload_t *payload) {
+    const char *enabled = getenv("DARLING_OS_LOG_STDERR");
+    if (enabled && !strcmp(enabled, "1")) {
+        _simple_dprintf(STDERR_FILENO, "os_log_simple[%llu:%llu] type=%u subsystem=%s: %s\n",
+            payload->pid, payload->tid, payload->type,
+            payload->subsystem ? payload->subsystem : "(none)", payload->message);
+    }
+}

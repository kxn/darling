+	pack->olp_format = format;
+	memset(pack->olp_reserved, 0, sizeof(pack->olp_reserved));
+	pack->olp_errno = (uint16_t)saved_errno;
+	pack->olp_data_size = (uint16_t)(size - sizeof(*pack));
+	return pack->olp_data;
+}
+
+void os_log_pack_send(os_log_pack_t pack, os_log_t log, os_log_type_t type) {
+	int caller_errno = errno;
+	libtrace_precondition(pack && pack->olp_format, "Invalid log-pack header");
+	/* Reuse the actual encoded-buffer decoder, ASL output, privacy policy,
+	 * hooks and fault callbacks. Preserve the pack's original call site and
+	 * errno for formatting while leaving the sending caller's errno intact. */
+	emit_encoded_log((void *)pack->olp_mh, log, type, pack->olp_format,
+	    pack->olp_data, pack->olp_data_size, pack->olp_errno, pack->olp_pc, NULL);
+	errno = caller_errno;
+}
+
+static char *send_and_compose(unsigned flags, char *buffer, uint32_t capacity,
+    void *dso, os_log_t log, os_log_type_t type, const char *format,
+    uint8_t *encoded, uint32_t size, int saved_errno, const void *pc) {
+	int caller_errno = errno;
+	char *text = NULL;
+	if (flags & 1) {
+		emit_encoded_log(dso, log, type & 0x7f, format, encoded, size,
+		    saved_errno, pc, (flags & 2) ? &text : NULL);
+	} else if (flags & 2) {
+		errno = saved_errno;
+		text = os_log_decode_buffer(format, encoded, size);
+	}
+	if (text && buffer && strlen(text) < capacity) {
+		memcpy(buffer, text, strlen(text) + 1);
+		free(text);
+		text = buffer;
+	}
+	errno = caller_errno;
+	return text;
+}
+
+/* Verified Intel ABI: flags bit 0 sends, bit 1 composes; the optional second
+ * parameter receives the original format pointer. A fitting caller buffer is
+ * returned unchanged; otherwise the returned string must be freed. */
+char *_os_log_send_and_compose_impl(unsigned flags, const char **out_format,
+    char *buffer, uint32_t capacity, void *dso, os_log_t log,
+    os_log_type_t type, const char *format, uint8_t *encoded, uint32_t size) {
+	if (out_format) *out_format = format;
+	return send_and_compose(flags, buffer, capacity, dso, log, type, format,
+	    encoded, size, errno, __builtin_return_address(0));
+}
+
+char *os_log_pack_send_and_compose(os_log_pack_t pack, os_log_t log,
+    os_log_type_t type, char *buffer, size_t capacity) {
+	libtrace_precondition(pack && pack->olp_format, "Invalid log-pack header");
+	return send_and_compose(3, buffer, (uint32_t)capacity,
+	    (void *)pack->olp_mh, log, type, pack->olp_format, pack->olp_data,
+	    pack->olp_data_size, pack->olp_errno, pack->olp_pc);
 }
 

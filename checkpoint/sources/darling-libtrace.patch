+/* Source delivery for the Intel OSLog hook ABI. Compiler pointer records are
+ * packed into bounded inline ranges before a hook sees them; private payloads
+ * remain absent under Darling's existing privacy policy. */
+#include <os/log_private.h>
+#include <Block.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+#import <Foundation/NSString.h>
+#include "os_log_s.h"
+#include "libtrace_assert.h"
+
+_Static_assert(offsetof(struct os_log_message_s,format)==0x58,"Intel format ABI");
+_Static_assert(offsetof(struct os_log_message_s,subsystem)==0x80,"Intel subsystem ABI");
+_Static_assert(sizeof(struct os_log_fault_info_s)==64,"Intel fault ABI");
+
+static pthread_mutex_t hook_lock=PTHREAD_MUTEX_INITIALIZER;
+static os_log_hook_t current_hook;
+static os_log_type_t hook_level=OS_LOG_TYPE_FAULT;
+static os_log_fault_callback_t fault_callback=os_log_fault_default_callback;
+static bool dispatcher_active;
+static pthread_once_t key_once=PTHREAD_ONCE_INIT;
+static pthread_key_t active_key;
+static void make_key(void) {
+    int error=pthread_key_create(&active_key,NULL);
+    libtrace_assert(error==0,"Cannot create log recursion key: %d",error);
+}
+
+os_log_hook_t os_log_set_hook(os_log_type_t level,os_log_hook_t hook) {
+    libtrace_precondition(hook!=NULL,"Log hook cannot be NULL");
+    (void)os_log_compare_enablement(level,level);
+    os_log_hook_t replacement=Block_copy(hook);
+    libtrace_assert(replacement!=NULL,"Cannot copy log hook");
+    pthread_mutex_lock(&hook_lock);
+    if(os_log_compare_enablement(level,hook_level)<0)hook_level=level;
+    os_log_hook_t previous=current_hook;current_hook=replacement;
+    __atomic_store_n(&dispatcher_active,true,__ATOMIC_RELEASE);
+    pthread_mutex_unlock(&hook_lock);
+    /* Like the native atomic exchange, return the previous copied block.
+     * The caller may chain it and owns that outstanding registration retain. */
+    return previous;
+}
+
+os_log_type_t os_log_get_type(os_log_message_t message) {
+    return (os_log_type_t)((message->trace_id>>8)&0xff);
+}
+
+void os_log_fault_default_callback(const struct os_log_fault_info_s *info) {
+    /* The original Intel default callback is a single return instruction. */
+    (void)info;
+}
+
+os_log_fault_callback_t os_log_set_fault_callback(os_log_fault_callback_t callback) {
+    pthread_mutex_lock(&hook_lock);
+    os_log_fault_callback_t previous=fault_callback;
+    if(callback){
+        fault_callback=callback; /* NULL queries; it does not clear. */
+        if(callback!=os_log_fault_default_callback)
+            __atomic_store_n(&dispatcher_active,true,__ATOMIC_RELEASE);
+    }
+    pthread_mutex_unlock(&hook_lock);return previous;
+}
+
+struct packed_log {uint8_t *bytes;size_t descriptors,pool,capacity;};
+static bool reserve(struct packed_log *p,size_t amount) {
+    if(amount>UINT16_MAX-p->descriptors-p->pool){errno=EOVERFLOW;return false;}
+    return true;
+}
+static bool range_record(struct packed_log *p,uint8_t descriptor,const void *bytes,size_t length,bool private) {
+    if(!reserve(p,6+(private?0:length)))return false;
+    uint16_t offset=(uint16_t)p->pool,n=(uint16_t)length;
+    uint8_t *record=p->bytes+p->descriptors;record[0]=descriptor;record[1]=4;
+    memcpy(record+2,&offset,2);memcpy(record+4,&n,2);p->descriptors+=6;
+    if(!private&&length){memcpy(p->bytes+p->capacity+p->pool,bytes,length);p->pool+=length;}
+    return true;
+}
+static bool raw_record(struct packed_log *p,uint8_t descriptor,const void *bytes,uint8_t length) {
+    if(!reserve(p,2+length))return false;
+    uint8_t *record=p->bytes+p->descriptors;record[0]=descriptor;record[1]=length;
+    memcpy(record+2,bytes,length);p->descriptors+=2+length;return true;
+}
+
+/* No record or pointed-to object is read before its envelope is validated.
+ * Pool offsets/lengths use the native unsigned 16-bit inline range encoding. */
+static uint8_t *pack_buffer(const uint8_t *source,uint32_t size,size_t *out_size,int saved_errno) {
+    if(!source||size<2){errno=EINVAL;return NULL;}
+    size_t cursor=2;
+    for(unsigned i=0;i<source[1];i++){
+        if(cursor>size||size-cursor<2||source[cursor+1]>size-cursor-2){errno=EINVAL;return NULL;}
+        cursor+=2+source[cursor+1];
+    }
+    if(cursor!=size){errno=EINVAL;return NULL;}
+    struct packed_log p={.capacity=UINT16_MAX,.descriptors=2};
+    p.bytes=malloc(2*UINT16_MAX);if(!p.bytes)return NULL;p.bytes[0]=source[0];p.bytes[1]=source[1];
+    cursor=2;uint64_t precision=UINT64_MAX;
+    @try {
+    for(unsigned i=0;i<source[1];i++){
+        uint8_t descriptor=source[cursor],length=source[cursor+1],kind=descriptor>>4,privacy=descriptor&15;
+        const uint8_t *value=source+cursor+2;cursor+=2+length;
+        if(privacy>2){errno=ENOTSUP;goto fail;}
+        bool private=privacy==1||(privacy==0&&kind>=2&&kind<=5);
+        if(private)descriptor=(descriptor&0xf0)|1;
+        if(kind==0||kind==1){
+            if(length!=1&&length!=2&&length!=4&&length!=8){errno=EINVAL;goto fail;}
+            if(kind==1){precision=0;memcpy(&precision,value,length);}
+            if(private){if(!range_record(&p,descriptor,NULL,length,true))goto fail;}
+            else if(!raw_record(&p,descriptor,value,length))goto fail;
+            if(kind==0)precision=UINT64_MAX;
+        }else if(kind>=2&&kind<=5){
+            if(length!=sizeof(void *)){errno=EINVAL;goto fail;}
+            if(private){if(!range_record(&p,descriptor,NULL,0,true))goto fail;precision=UINT64_MAX;continue;}
+            const void *pointer=NULL;memcpy(&pointer,value,sizeof(pointer));
+            size_t n=0;const void *data=pointer;char *converted=NULL;
+            if(kind==2){
+                const char *text=pointer?pointer:"(null)";size_t limit=precision<UINT16_MAX?precision:UINT16_MAX;
+                n=strnlen(text,limit);
+                if(n==UINT16_MAX){errno=EOVERFLOW;goto fail;}
+                /* The serialized pool owns a terminator, including precision
+                 * zero, without reading beyond a precision-bounded pointer. */
+                converted=malloc(n+1);if(!converted)goto fail;
+                if(n)memcpy(converted,text,n);converted[n++]=0;data=converted;
+            }else if(kind==3){
+                if(precision==UINT64_MAX||precision>UINT16_MAX){errno=EINVAL;goto fail;}
+                n=pointer?(size_t)precision:0;
+            }else if(kind==4){
+                NSString *description=pointer?[(id)pointer description]:nil;
+                const char *text=[description UTF8String];if(!text)text="(null)";
+                n=strnlen(text,UINT16_MAX);if(n==UINT16_MAX){errno=EOVERFLOW;goto fail;}
+                converted=strdup(text);if(!converted)goto fail;data=converted;n++;
+            }else{
+                /* The native wire pool contains UTF-8 even for a compiler
+                 * wide-string pointer; sending raw wchar_t truncates at its
+                 * first zero byte. Convert without the process locale. */
+                const wchar_t *text=pointer;size_t count=0;
+                converted=malloc(UINT16_MAX);if(!converted)goto fail;
+                if(text)while(count<precision){
+                    uint32_t c=(uint32_t)text[count];if(!c)break;count++;
+                    if(c>0x10ffff||(c>=0xd800&&c<=0xdfff)){free(converted);errno=EILSEQ;goto fail;}
+                    size_t length=c<0x80?1:c<0x800?2:c<0x10000?3:4;
+                    if(n+length>=UINT16_MAX){free(converted);errno=EOVERFLOW;goto fail;}
+                    if(length==1)converted[n++]=(char)c;
+                    else{for(size_t j=length-1;j>0;j--){converted[n+j]=(char)(0x80|(c&63));c>>=6;}converted[n]=(char)((length==2?0xc0:length==3?0xe0:0xf0)|c);n+=length;}
+                }
+                else{memcpy(converted,"(null)",6);n=6;}
+                converted[n++]=0;data=converted;
+            }
+            bool ok=range_record(&p,descriptor,data,n,false);free(converted);if(!ok)goto fail;
+            precision=UINT64_MAX;
+        }else if(kind==6){
+            if(length!=0){errno=EINVAL;goto fail;}
+            /* Compiler ERRNO is an emit-time request. Native serialized %m
+             * consumes a SCALAR containing the saved errno, not kind 6. */
+            descriptor&=15;
+            if(private){if(!range_record(&p,descriptor,NULL,sizeof(saved_errno),true))goto fail;}
+            else if(!raw_record(&p,descriptor,&saved_errno,sizeof(saved_errno)))goto fail;
+        }else{errno=ENOTSUP;goto fail;}
+    }
+    } @catch(id exception) {free(p.bytes);@throw;}
+    memmove(p.bytes+p.descriptors,p.bytes+p.capacity,p.pool);
+    *out_size=p.descriptors+p.pool;return p.bytes;
+fail:
+    free(p.bytes);return NULL;
+}
+
+__XNU_PRIVATE_EXTERN
+void _darling_os_log_dispatch(os_log_t log,os_log_type_t type,const char *format,
+    const uint8_t *buffer,uint32_t size,const char *decoded,int saved_errno,const void *pc) {
+    /* A process which never registered an observer needs no callback TLS or
+     * locks. In particular, ordinary early Foundation logging must not create
+     * callback-specific pthread state before its own initialization finishes. */
+    if(!__atomic_load_n(&dispatcher_active,__ATOMIC_ACQUIRE))return;
+    struct os_log_s *object=(struct os_log_s *)log;
+    pthread_once(&key_once,make_key);
+    if(pthread_getspecific(active_key))return;
+    pthread_mutex_lock(&hook_lock);
+    os_log_hook_t hook=current_hook&&os_log_compare_enablement(type,hook_level)>=0?Block_copy(current_hook):NULL;
+    os_log_fault_callback_t fault=type==OS_LOG_TYPE_FAULT?fault_callback:NULL;
+    pthread_mutex_unlock(&hook_lock);
+    if(!hook&&(!fault||fault==os_log_fault_default_callback))return;
+    int before=errno;uint8_t *packed=NULL;size_t packed_size=0;
+    pthread_setspecific(active_key,(void *)1);
+    @try {
+        if(hook){
+            packed=pack_buffer(buffer,size,&packed_size,saved_errno);
+            if(packed){
+                struct os_log_message_s message={.trace_id=((uint64_t)type<<8)|4,
+                    .format=format,.buffer=packed,.buffer_sz=packed_size,
+                    .subsystem=object->subsystem,.category=object->category};
+                hook(type,&message);
+            }
+        }
+        if(fault&&decoded){
+            struct os_log_fault_info_s info={.version=1,.log=log,
+                .subsystem=object->subsystem,.category=object->category,
+                .format=format,.message=decoded,.pc=pc};
+            fault(&info);
+        }
+    } @finally {
+        free(packed);if(hook)Block_release(hook);
+        pthread_setspecific(active_key,NULL);errno=before;
+    }
+}

+            if (n!=ssize_t(bytes.size())) throw EIO;
+            queue.pop_front();
+        }
+        if (lost) {
+            std::vector<uint8_t> bytes;append(bytes,int32_t(Dropped));append(bytes,int32_t(0));append(bytes,Done);

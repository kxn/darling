--- a/src/launchd.m
+++ b/src/launchd.m
@@ -21,6 +21,130 @@
 #import <launch.h>
 #import <xpc/util.h>
 #import <xpc/private.h>
+#import <xpc/private/launch_service_stats.h>
+#import <xpc/private/service.h>

diff --git a/libsyscall/wrappers/statfs_ext.c b/libsyscall/wrappers/statfs_ext.c
new file mode 100644
index 0000000..5a99986
--- /dev/null
+++ b/libsyscall/wrappers/statfs_ext.c
@@ -0,0 +1,195 @@
+/*
